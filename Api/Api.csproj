<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <!-- Пакеты AlfaHackaton.* восстанавливаются из GitHub Packages при docker build
         (нужен GITHUB_TOKEN с read:packages). Локально хватает NuGet-кэша. -->
    <ItemGroup>
      <PackageReference Include="AlfaHackaton.Auth" Version="[1.3.0]" />
      <PackageReference Include="AlfaHackaton.Controllers" Version="[1.4.1]" />
      <PackageReference Include="AlfaHackaton.DapperContext" Version="[1.1.0]" />
      <PackageReference Include="AlfaHackaton.MongoContext" Version="[1.0.0]" />
      <PackageReference Include="FluentMigrator.Runner" Version="6.2.0" />
    </ItemGroup>

</Project>
